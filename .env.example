# Azure Speech credentials
SPEECH_KEY=
SPEECH_REGION=

# Speech behavior
PROCTO_SPEECH_RECOGNITION_LANGUAGE=te-IN
PROCTO_SPEECH_SYNTHESIS_VOICE=te-IN-ShrutiNeural

# Wake-word and microphone behavior
# Leave PROCTO_WAKE_WORD_MODEL empty to use openwakeword's bundled model.
PROCTO_WAKE_WORD_MODEL=
PROCTO_WAKE_WORD_THRESHOLD=0.15
# Set to a device index or device name. Leave empty for the system default.
PROCTO_AUDIO_DEVICE=
PROCTO_AUDIO_SAMPLE_RATE=16000
PROCTO_AUDIO_BLOCK_SIZE=1280
